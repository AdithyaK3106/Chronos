 SCHEMA = """
 -- Intent Locks (Wedge 3)
@@ -116,3 +117,13 @@ def get_connection(db_path: Union[str, Path] = ":memory:") -> sqlite3.Connection
     
     con.executescript(SCHEMA)
     return con
+
+
+@contextmanager
+def connection(db_path: Union[str, Path] = ":memory:") -> Iterator[sqlite3.Connection]:
+    """`with connection(path) as con:` -- a get_connection() connection that is always closed."""
+    con = get_connection(db_path)
+    try:
+        yield con
+    finally:
+        con.close()
