+# Military (MoD): upward arrow + year (2 digits) + class letter + serial (6 digits) + check letter
+MILITARY_PATTERN = re.compile(r"^([0-9]{2})([A-Z])([0-9]{6})([A-Z])$")
+
+# Diplomatic: mission/country code (1-3 digits) + CD / CC / UN + serial (1-4 digits)
+DIPLOMATIC_PATTERN = re.compile(r"^([0-9]{1,3})(CD|CC|UN)([0-9]{1,4})$")
+
 
