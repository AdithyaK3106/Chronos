+def renew_lock(
+    con: sqlite3.Connection,
+    node_id: str,
+    agent_id: str,
+    session_id: str,
+    ttl: int = DEFAULT_TTL,
+) -> dict[str, Any]:
+    """Heartbeat: extend a lease that this agent and session still hold. Never (re)creates a lock.
+
+    Heartbeats used to go through acquire_lock(), so one arriving just after release_lock()
+    re-created the released lock. This only updates an existing, unexpired row owned by the caller.
+    """
+    now = _utc_now()
+    now_str = _iso(now)
+    expires_str = _iso(now + timedelta(seconds=ttl))
+    con.execute("BEGIN IMMEDIATE")
+    try:
+        cur = con.execute(
+            "UPDATE intent_locks SET expires_at = ? "
+            "WHERE node_id = ? AND agent_id = ? AND session_id = ? AND expires_at >= ?",
+            (expires_str, node_id, agent_id, session_id, now_str),
+        )
+        if cur.rowcount != 1:
+            con.execute("ROLLBACK")
+            return {"renewed": False, "reason": "not_held", "node_id": node_id}
+        con.execute(
+            "INSERT INTO provenance_events (node_id, agent_id, session_id, action, reason, timestamp) "
+            "VALUES (?, ?, ?, 'renew', 'heartbeat', ?)",
+            (node_id, agent_id, session_id, now_str),
+        )
+        con.execute("COMMIT")
+        return {"renewed": True, "node_id": node_id, "agent_id": agent_id, "expires_at": expires_str}
+    except Exception:
+        try:
+            con.execute("ROLLBACK")
+        except Exception:
+            pass
+        raise
+
+
