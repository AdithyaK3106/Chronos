         return [dict(r) for r in rows]
 
     def as_of_impact(self, symbol_name: str, as_of: str | None = None, max_depth: int = 3) -> list[dict[str, Any]]:
+        """Transitive callers of `symbol_name`, each once at its shortest depth.
+
+        Edges store the callee as a bare name (as as_of_callers() expects), so the traversal walks by
+        caller *name*. Cycles (mutual or self recursion) are cut by UNION + depth limit and collapsed
+        with MIN(depth); the queried symbol is never its own impact.
+        """
         t = _normalize_iso(as_of)
         rows = self.con.execute(
             """
-            WITH RECURSIVE impact_tree(node_id, depth) AS (
-                SELECT id, 0 FROM code_nodes WHERE name = ? OR id = ?
+            WITH RECURSIVE impact_tree(name, depth) AS (
+                SELECT ?, 0
                 UNION
-                SELECT e.src, it.depth + 1
-                FROM code_edges e
-                JOIN impact_tree it ON (e.dst = it.node_id OR e.dst LIKE '%::' || it.node_id || '::%')
+                SELECT n.name, it.depth + 1
+                FROM impact_tree it
+                JOIN code_edges e ON (e.dst = it.name OR e.dst LIKE '%::' || it.name || '::%')
+                JOIN code_nodes n ON e.src = n.id
                 WHERE it.depth < ?
                   AND e.valid_at <= ?
                   AND (e.invalid_at IS NULL OR e.invalid_at > ?)
             )
-            SELECT DISTINCT n.id, n.name, n.path, n.kind, it.depth
+            SELECT n.id, n.name, n.path, n.kind, MIN(it.depth) AS depth
             FROM impact_tree it
-            JOIN code_nodes n ON it.node_id = n.id
-            WHERE it.depth > 0
-            ORDER BY it.depth ASC, n.name ASC
+            JOIN code_nodes n ON n.name = it.name
+            WHERE it.depth > 0 AND n.name != ? AND n.id != ?
+            GROUP BY n.id
+            ORDER BY depth ASC, n.name ASC
             """,
-            (symbol_name, symbol_name, max_depth, t, t),
+            (symbol_name, max_depth, t, t, symbol_name, symbol_name),
         ).fetchall()
         return [dict(r) for r in rows]
 
