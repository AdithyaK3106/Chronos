+    @staticmethod
+    def _try_special(raw_text: str, clean: str) -> NormalizedRegistration | None:
+        mil = MILITARY_PATTERN.match(clean)
+        if mil:
+            return NormalizedRegistration(raw_text, clean, " ".join(mil.groups()), True)
+        dip = DIPLOMATIC_PATTERN.match(clean)
+        if dip:
+            return NormalizedRegistration(raw_text, clean, " ".join(dip.groups()), True)
+        return None
+
