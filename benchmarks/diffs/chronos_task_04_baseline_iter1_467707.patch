+    return {
+        "$schema": "https://json-schema.org/draft/2020-12/schema",
+        "title": "ActiveEnforcementRules",
+        "type": "object",
+        "properties": {
+            "rules": {
+                "type": "array",
+                "items": {
+                    "type": "object",
+                    "properties": {
+                        "rule_id": {"type": "string"},
+                        "language": {"type": "string"},
+                        "rule_text": {"type": "string"},
+                        "yaml_pattern": {"type": ["string", "null"]},
+                        "status": {"type": "string", "enum": [BLOCKING]},
+                        "detectability_passed": {"type": "integer"},
+                        "created_at": {"type": "string"},
+                        "promoted_at": {"type": ["string", "null"]},
+                        "promoted_by": {"type": ["string", "null"]},
+                    },
+                    "required": ["rule_id", "language", "rule_text", "status"],
+                },
+            }
+        },
+        "required": ["rules"],
+        "rules": active_rules,
+    }
