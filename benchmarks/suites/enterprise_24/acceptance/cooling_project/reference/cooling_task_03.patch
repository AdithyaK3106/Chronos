@@ -16,6 +16,19 @@ class CoolingState(Enum):
     RECOVERY = "RECOVERY"
     FAILSAFE = "FAILSAFE"
 
+FAILSAFE_FAN_SPEED = 100.0
+
+
+def apply_fan_hysteresis(current_speed: float, target_speed: float, band: float = 5.0) -> float:
+    """Suppress fan steps smaller than `band` percentage points, so jittery targets do not make the
+    fan oscillate. A failsafe target (100%) always passes immediately; band <= 0 disables it."""
+    if band <= 0 or target_speed >= FAILSAFE_FAN_SPEED:
+        return target_speed
+    if abs(target_speed - current_speed) < band:
+        return current_speed
+    return target_speed
+
