+# A symptom preceded (within a few words) by one of these is a negated mention: "no chest pain",
+# "denies chest pain", "I don't have chest pain". Negated mentions must not trigger a veto.
+NEGATION_CUES = re.compile(
+    r"\b(no|not|denies|deny|denied|without|never|don't have|do not have|doesn't have|does not have|negative for)\b"
+    r"(?:\W+\w+){0,2}\W*$"
+)
+
+
+def _mentioned_without_negation(symptom: str, text: str) -> bool:
+    """True if `symptom` occurs in `text` at least once without a negation just before it."""
+    for match in re.finditer(re.escape(symptom), text):
+        preceding = text[max(0, match.start() - 40):match.start()]
+        if not NEGATION_CUES.search(preceding):
+            return True
+    return False
+
+
 class EmergencyRuleEngine:
     def __init__(self):
         pass
