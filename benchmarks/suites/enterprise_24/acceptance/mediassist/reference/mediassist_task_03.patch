+SYMPTOM_SEVERITY_WEIGHT = {"mild": 0.2, "moderate": 0.5, "severe": 0.8}
+HIGH_URGENCY_SCORE = 0.7
+
+
+def _vital_points(vitals: dict) -> float:
+    points = 0.0
+    temp, hr, spo2, sbp = (vitals.get(k) for k in ("temperature_c", "heart_rate", "spo2", "systolic_bp"))
+    if temp is not None:
+        points += 0.3 if temp >= 39.5 else 0.15 if temp >= 38.5 else 0.0
+    if hr is not None:
+        points += 0.3 if hr >= 120 else 0.15 if hr >= 100 else 0.0
+    if spo2 is not None:
+        points += 0.4 if spo2 < 92 else 0.2 if spo2 < 95 else 0.0
+    if sbp is not None and sbp < 90:
+        points += 0.4
+    return points
+
+
+def compute_severity_score(vitals: dict, symptom_severity: str) -> float:
+    """0.5 x symptom weight (mild 0.2, moderate 0.5, severe 0.8; unknown = moderate) + vital points, capped at 1."""
+    weight = SYMPTOM_SEVERITY_WEIGHT.get(symptom_severity, SYMPTOM_SEVERITY_WEIGHT["moderate"])
+    return round(min(1.0, 0.5 * weight + _vital_points(vitals or {})), 6)
+
