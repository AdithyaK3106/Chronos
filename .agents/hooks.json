{
  "chronos-lock-enforcement": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python verify_lock.py"
          }
        ]
      }
    ]
  },
  "chronos-context-reminder": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python inject_chronos_reminder.py"
      }
    ]
  }
}
