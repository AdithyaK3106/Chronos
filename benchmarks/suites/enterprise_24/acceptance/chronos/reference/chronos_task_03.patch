+    def query_symbols(self, pattern: str | None = None, kind: str | None = None, limit: int = 100) -> list[dict[str, Any]]:
+        """Indexed symbols whose name matches the regular expression `pattern` (re.search), sorted by name.
+
+        Raises ValueError for an invalid pattern. SQLite has no built-in REGEXP, so filter in Python.
+        """
+        try:
+            rx = re.compile(pattern) if pattern else None
+        except re.error as exc:
+            raise ValueError(f"Invalid symbol pattern {pattern!r}: {exc}") from exc
+        sql = "SELECT id, name, path, kind FROM code_nodes"
+        params: list[Any] = []
+        if kind:
+            sql += " WHERE kind = ?"
+            params.append(kind)
+        sql += " ORDER BY name ASC"
+        out = []
+        for r in self.con.execute(sql, params):
+            if rx is None or rx.search(r["name"]):
+                out.append(dict(r))
+                if len(out) >= limit:
+                    break
+        return out
