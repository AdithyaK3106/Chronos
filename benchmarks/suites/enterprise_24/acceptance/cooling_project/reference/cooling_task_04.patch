+    def check_sensor_timeout(self, last_sample_time: float, now: float | None = None, timeout_s: float = SENSOR_TIMEOUT_S):
+        """If the sensor has been silent for more than timeout_s, go to FAILSAFE and broadcast once.
+
+        Returns the packet sent, or None (sensor fresh, or this silence was already reported).
+        """
+        now = time.time() if now is None else now
+        silence = now - last_sample_time
+        if silence <= timeout_s:
+            self._timeout_episode_sample = None
+            return None
+        if self._timeout_episode_sample == last_sample_time:
+            return None
+        self._timeout_episode_sample = last_sample_time
