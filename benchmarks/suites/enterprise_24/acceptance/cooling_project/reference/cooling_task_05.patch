+class WindowFeatureExtractor:
+    """Rolling-window means over named channels (e.g. cpu, gpu, heat), reusable outside FeatureProcessor."""
+
+    def __init__(self, channels=("cpu", "gpu", "heat"), maxlen: int = 10):
+        self.channels = tuple(channels)
+        self._buffers = {c: deque(maxlen=maxlen) for c in self.channels}
+
+    def push(self, **values: float) -> None:
+        for channel, value in values.items():
+            self._buffers[channel].append(value)
+
+    def mean(self, channel: str, window: int) -> float:
+        vals = list(self._buffers[channel])[-window:]
+        return sum(vals) / len(vals)
+
+    def reset(self) -> None:
+        for buf in self._buffers.values():
+            buf.clear()
+
+
